{
  "name": "harness-engineering",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.3.3"
  },
  "scripts": {
    "typecheck": "bun run --filter '@yok/*' typecheck && tsc -p skills/create-workspace && tsc -p skills/ticket-fetcher && tsc -p skills/baseline && tsc -p skills/qa && tsc -p skills/retro && tsc -p skills/fix && tsc -p skills/code-review && tsc -p skills/learn",
    "test": "bun test --parallel ./packages ./skills",
    "lint": "biome check",
    "check": "bun scripts/check.ts",
    "sdk-types": "bun scripts/sdk-types.ts",
    "lint:fix": "biome check --write",
    "cli": "bun --no-env-file packages/cli/src/index.ts",
    "release:version": "bun scripts/version.ts",
    "release:version:node": "node scripts/version.ts",
    "test:scripts": "node --test scripts/*.test.ts",
    "test:scripts:bun": "bun test ./scripts/",
    "test:hooks": "node --test hooks/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
